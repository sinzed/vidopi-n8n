{
  "name": "n8n-nodes-vidopi",
  "version": "2.0.1",
  "description": "n8n custom nodes for Vidopi video processing API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "logo.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinzed/vidopi-n8n.git"
  },
  "homepage": "https://github.com/sinzed/vidopi-n8n#readme",
  "bugs": {
    "url": "https://github.com/sinzed/vidopi-n8n/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/postbuild.js",
    "dev": "./scripts/start-n8n-with-vidopi.sh",
    "start:n8n": "./scripts/start-n8n-with-vidopi.sh",
    "lint": "eslint \"nodes/**/*.ts\" \"credentials/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "n8n",
    "n8n-community-node",
    "n8n-community-node-package",
    "vidopi",
    "video",
    "video-processing",
    "api"
  ],
  "author": {
    "name": "Saeed Zahedi",
    "email": "development@vidopi.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "./dist/nodes/Vidopi/Vidopi.node.js",
      "./dist/nodes/Vidopi/VidopiTrigger.node.js"
    ],
    "credentials": [
      "./dist/credentials/VidopiApi.credentials.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.14.0",
    "n8n": "^2.23.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.46.3"
  }
}
